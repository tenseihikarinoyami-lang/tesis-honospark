# Variables de entorno para ThesisForge AI (Vercel)
# Copia este archivo como .env y rellena los valores

# ─── Vercel Postgres (se configura automáticamente al vincular DB en Vercel) ───
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ─── Proveedores de IA ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
